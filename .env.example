# Somente desenvolvimento local. Valores de demonstração, não usar em produção.
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# VITE_* é público e será incorporado ao frontend. Nunca colocar segredos aqui.
VITE_API_URL=http://localhost:3000
