{
  "name": "selleros",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0 <23 || >=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @selleros/web dev",
    "dev:api": "pnpm --filter @selleros/api dev",
    "dev:worker": "pnpm --filter @selleros/worker dev",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && pnpm test:db-config",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "infra:status": "docker compose --env-file .env -f infra/docker-compose.yml ps",
    "db:test:setup": "node scripts/test-db.mjs setup",
    "db:test:up": "node scripts/test-db.mjs up",
    "db:test:status": "node scripts/test-db.mjs status",
    "db:test:down": "node scripts/test-db.mjs down",
    "db:test:stop-postgres": "node scripts/test-db.mjs stop-postgres",
    "db:test:check": "node scripts/test-db.mjs check",
    "db:validate": "node scripts/test-db.mjs validate",
    "db:generate": "node scripts/test-db.mjs generate",
    "db:migrate:status:test": "node scripts/test-db.mjs migrate-status",
    "db:migrate:deploy:test": "node scripts/test-db.mjs migrate-deploy",
    "test:db-config": "node scripts/test-db-config.test.mjs",
    "db:test:prisma": "pnpm db:generate && tsx scripts/prisma-check.mts",
    "db:typecheck": "pnpm db:generate && tsc -p tsconfig.persistence.json",
    "db:test:enroll": "node scripts/test-db.mjs enroll",
    "db:test:identity": "node scripts/test-db.mjs identity",
    "db:test:roles": "node scripts/test-db.mjs roles",
    "db:test:preflight": "node scripts/test-db.mjs preflight",
    "test:isolation": "pnpm db:generate && tsx tests/integration/isolation.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "pg": "8.16.3",
    "prettier": "^3.7.0",
    "prisma": "7.10.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.0"
  }
}
